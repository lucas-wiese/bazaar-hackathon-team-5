# Copy to .env (gitignored), fill in, then load it with: source .env
export BAZAAR_URL=https://bazaar.causaprima.ai
export BAZAAR_KEY=tk-xxxx-xxxx      # the team key (one per team, shared by every process)
export ANTHROPIC_API_KEY=
# export BROKER_KEY=bk_...          # once we open a venue (level 2)
# ntfy.sh topics for phone alerts (tools/notify.py). Pick long unguessable names; anyone with the name can read them.
# Empty = alerts go to stderr only.
export NTFY_DANI=
export NTFY_LUCAS=
# The hub (Postgres, hub/README.md): a writer URL for the collectors, importer and model; a reader URL for everything else.
HUB_WRITER_URL=
HUB_READER_URL=
